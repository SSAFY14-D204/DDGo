pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    timestamps()
  }

  environment {
    IMAGE = "leetaehee0/ddgo-backend"
    DEPLOY_DIR = "/opt/ddgo"
    REGISTRY = "https://index.docker.io/v1/"
    GRADLE_USER_HOME = "/var/lib/jenkins/.gradle"
    DOCKER_BUILDKIT = "1"
    COMPOSE_DOCKER_CLI_BUILD = "1"
  }

  stages {
    stage('Checkout') {
      steps {
        script {
          mattermostSend(
            color: '#2F86EB',
            message: """🚀 **DDGo 배포 시작**
- Job: ${env.JOB_NAME}
- Build: #${env.BUILD_NUMBER}
- Branch: ${env.BRANCH_NAME ?: "dev"}
- URL: ${env.BUILD_URL}"""
          )
        }

        echo "===== [1/5] 소스 체크아웃 시작 ====="
        checkout scm
        echo "===== [1/5] 소스 체크아웃 완료 ====="
      }
    }

    stage('Build Jar') {
      steps {
        dir('DDGo') {
          script {
            echo "===== [2/5] Gradle 빌드 시작 ====="
            sh 'chmod +x gradlew'

            // clean 제거 + Gradle 캐시 사용 + 병렬 빌드
            sh './gradlew bootJar -x test --build-cache --parallel --daemon'

            env.SHORT_HASH = sh(
              script: "git rev-parse --short HEAD",
              returnStdout: true
            ).trim()

            env.TAG = "${env.BUILD_NUMBER}-${env.SHORT_HASH}"

            // plain.jar 제외하고 실제 실행 jar 1개 선택
            env.JAR_FILE = sh(
              script: "find build/libs -maxdepth 1 -type f -name '*.jar' ! -name '*-plain.jar' | head -n 1",
              returnStdout: true
            ).trim()

            if (!env.JAR_FILE) {
              error("배포할 JAR 파일을 찾지 못했습니다.")
            }

            currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.TAG}"
            currentBuild.description = "이미지 태그: ${IMAGE}:${env.TAG}"

            sh "ls -lh ${env.JAR_FILE}"
            echo "실행 JAR: ${env.JAR_FILE}"
            echo "===== [2/5] Gradle 빌드 완료 ====="
          }
        }
      }
    }

    stage('Docker Build') {
      steps {
        script {
          echo "===== [3/5] Docker 이미지 빌드 시작 ====="
          echo "생성할 이미지 태그: ${IMAGE}:${env.TAG}"

          // 이전 latest를 캐시 소스로만 사용
          sh "docker pull ${IMAGE}:latest || true"

          dir('DDGo') {
            sh """
              docker build \
                --build-arg JAR_FILE=${env.JAR_FILE} \
                --cache-from ${IMAGE}:latest \
                -t ${IMAGE}:${env.TAG} \
                -t ${IMAGE}:latest \
                .
            """
          }

          echo "===== [3/5] Docker 이미지 빌드 완료 ====="
        }
      }
    }

    stage('Docker Push') {
      steps {
        script {
          echo "===== [4/5] DockerHub Push 시작 ====="

          docker.withRegistry("${REGISTRY}", 'dockerhub-cred') {
            sh "docker push ${IMAGE}:${env.TAG}"
            sh "docker push ${IMAGE}:latest"
          }

          echo "DockerHub Push 완료: ${IMAGE}:${env.TAG}"
          echo "===== [4/5] DockerHub Push 완료 ====="
        }
      }
    }

    stage('Deploy + HealthCheck + Rollback') {
      steps {
        script {
          echo "===== [5/5] 배포 시작 ====="

          def prev = sh(
            script: """
              cd ${DEPLOY_DIR}
              if [ -f .env ]; then
                grep '^DOCKER_IMAGE=' .env | cut -d'=' -f2
              fi
            """,
            returnStdout: true
          ).trim()

          echo "이전 배포 이미지: ${prev ?: '없음'}"
          echo "새 배포 이미지: ${IMAGE}:${env.TAG}"

          try {
            sh """
              set -e
              docker image inspect ${IMAGE}:${env.TAG} >/dev/null 2>&1 || docker pull ${IMAGE}:${env.TAG}
              cd ${DEPLOY_DIR}
              sed -i 's|^DOCKER_IMAGE=.*|DOCKER_IMAGE=${IMAGE}:${env.TAG}|' .env
              docker rm -f ddgo-backend || true
              docker compose up -d --no-deps spring-boot
              docker compose ps
            """

            echo "백엔드 컨테이너 교체 완료, 헬스체크 시작"

            def ok = false
            for (int i = 1; i <= 12; i++) {
              sleep 5
              def code = sh(
                script: "curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8080/actuator/health || true",
                returnStdout: true
              ).trim()

              echo "Health Check ${i}/12 -> HTTP ${code}"

              if (code == "200") {
                ok = true
                echo "헬스체크 성공"
                break
              }
            }

            if (!ok) {
              sh 'docker logs --tail 100 ddgo-backend || true'
              error("헬스체크 실패: 새 버전 배포 실패")
            }

            echo "===== 배포 성공 ====="
            echo "최종 배포 이미지: ${IMAGE}:${env.TAG}"

          } catch (e) {
            echo "===== 배포 실패 감지 ====="

            if (prev) {
              echo "롤백 시작: ${prev}"

              sh """
                set -e
                docker image inspect ${prev} >/dev/null 2>&1 || docker pull ${prev}
                cd ${DEPLOY_DIR}
                sed -i 's|^DOCKER_IMAGE=.*|DOCKER_IMAGE=${prev}|' .env
                docker rm -f ddgo-backend || true
                docker compose up -d --no-deps spring-boot
                docker compose ps
              """

              sh 'docker logs --tail 100 ddgo-backend || true'

              echo "===== 롤백 완료 ====="
              echo "복구 이미지: ${prev}"

              mattermostSend(
                color: 'warning',
                message: """⚠️ **DDGo 배포 실패 → 롤백 완료**
- Job: ${env.JOB_NAME}
- Build: #${env.BUILD_NUMBER}
- 실패 이미지: ${IMAGE}:${env.TAG}
- 복구 이미지: ${prev}
- URL: ${env.BUILD_URL}"""
              )

              currentBuild.description = "배포 실패 → 롤백 완료 (${prev})"
            } else {
              echo "이전 배포 이미지가 없어 롤백을 수행할 수 없습니다."

              mattermostSend(
                color: 'danger',
                message: """❌ **DDGo 배포 실패**
- Job: ${env.JOB_NAME}
- Build: #${env.BUILD_NUMBER}
- 실패 이미지: ${IMAGE}:${env.TAG}
- 롤백 불가: 이전 이미지 없음
- URL: ${env.BUILD_URL}"""
              )

              currentBuild.description = "배포 실패 (롤백 불가)"
            }

            throw e
          }
        }
      }
    }
  }

  post {
    success {
      echo "########################################"
      echo "# 최종 결과: 배포 성공"
      echo "# 이미지: ${IMAGE}:${env.TAG}"
      echo "########################################"

      script {
        currentBuild.description = "배포 성공 (${IMAGE}:${env.TAG})"
      }

      mattermostSend(
        color: 'good',
        message: """✅ **DDGo 배포 성공**
- Job: ${env.JOB_NAME}
- Build: #${env.BUILD_NUMBER}
- Image: ${IMAGE}:${env.TAG}
- URL: ${env.BUILD_URL}"""
      )
    }

    failure {
      echo "########################################"
      echo "# 최종 결과: 배포 실패"
      echo "# Jenkins 콘솔 로그 확인 필요"
      echo "########################################"

      script {
        if (!currentBuild.description) {
          currentBuild.description = "배포 실패"
        }
      }

      mattermostSend(
        color: 'danger',
        message: """❌ **DDGo 배포 실패**
- Job: ${env.JOB_NAME}
- Build: #${env.BUILD_NUMBER}
- URL: ${env.BUILD_URL}"""
      )
    }

    always {
      echo "불필요한 Docker dangling 이미지 정리 시작"
      sh 'docker image prune -f || true'
      echo "워크스페이스 정리 시작"
      cleanWs()
      echo "파이프라인 종료"
    }
  }
}