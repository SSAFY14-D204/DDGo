# ── 서버 기본 설정 ──────────────────────────────────────────────────────────
APP_NAME=MuJoCo Humanoid Analysis Server
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── CORS 설정 (쉼표로 구분) ─────────────────────────────────────────────────
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_ORIGINS=*

# ── MuJoCo 모델 경로 ────────────────────────────────────────────────────────
# 기본값: 프로젝트 루트의 humanoid.xml (자동 탐색)
# MUJOCO_MODEL_PATH=C:/path/to/humanoid.xml

# ── 캘리브레이션 경로 ───────────────────────────────────────────────────────
# 기본값: 프로젝트 루트의 calibration.json (자동 탐색)
# CALIBRATION_JSON_PATH=C:/path/to/calibration.json

# ── 분석 파라미터 기본값 ────────────────────────────────────────────────────
STRESS_RATIO_THRESHOLD=0.8
STRENGTH_RATIO_THRESHOLD=1.0
STRENGTH_CONSECUTIVE_FRAMES=5
SUPPORT_MARGIN_M=0.15
HOLD_LOCK_TOLERANCE_M=0.06
BALANCE_FAILURE_THRESHOLD=0.08
SCALE_MODEL_SEGMENTS=false
