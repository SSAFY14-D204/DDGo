DDGO_DOCKER_IMAGE=yourdockerhub/ddgo-ai-server:0.1.0
DDGO_CONTAINER_NAME=ddgo-ai-server
DDGO_HOST_PORT=8000

DDGO_APP_VERSION=0.1.0
DDGO_DEBUG=false
DDGO_LOG_LEVEL=INFO

DDGO_STRESS_RATIO_THRESHOLD=0.8
DDGO_STRENGTH_RATIO_THRESHOLD=1.0
DDGO_STRENGTH_CONSECUTIVE_FRAMES=5
DDGO_SUPPORT_MARGIN_M=0.15
DDGO_HOLD_LOCK_TOLERANCE_M=0.06
DDGO_BALANCE_FAILURE_THRESHOLD=0.08
DDGO_SCALE_MODEL_SEGMENTS=false
